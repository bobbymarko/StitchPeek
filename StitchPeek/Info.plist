<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.graphics-design</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string></string>

	<!-- There is no system UTI for .dst, so StitchPeek declares one. This lives in the host
	     app only; both extensions merely reference the identifier.

	     Exported rather than Imported: strictly .dst is Tajima's format, so Imported is the
	     pedantically correct key, but nothing else on this system claims the type and
	     Exported ranks higher in LaunchServices. If .dst previews ever start resolving to
	     another app, this ranking is the first thing to look at. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<!-- Wilcom EmbroideryStudio / Hatch design. Like .dst, no system type exists. The file is
		     an OLE2 compound file, but it conforms to public.data only: claiming a more specific
		     parent would not help LaunchServices and could pull in other handlers. The design
		     stream inside is encrypted; StitchPeek shows the preview images and design facts
		     stored beside it, never the stitches. -->
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.bobbymarko.stitchpeek.wilcom-emb</string>
			<key>UTTypeDescription</key>
			<string>Wilcom Embroidery Design</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>emb</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.bobbymarko.stitchpeek.tajima-dst</string>
			<key>UTTypeDescription</key>
			<string>Tajima Embroidery Design</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>dst</string>
				</array>
			</dict>
		</dict>
	</array>

	<!-- Embrilliance (com.britonleap.Embrilliance) also exports a type for .dst, and on a
	     machine where it is installed LaunchServices resolves .dst to com.britonleap.dst
	     rather than to the declaration above — so supporting only our own identifier means
	     the Quick Look extensions are simply never asked. Importing the type here makes
	     `UTType("com.britonleap.dst")` resolve even if Embrilliance is later removed. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<!-- Same story for .emb: Embrilliance exports com.britonleap.emb, and where it is
		     installed every .emb resolves to that type, never to StitchPeek's wilcom-emb. Without
		     claiming it here and in both extensions, .emb previews and thumbnails silently never
		     ran on a Mac with Embrilliance (checked: qlmanage made a .dst thumbnail but no .emb). -->
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.britonleap.emb</string>
			<key>UTTypeDescription</key>
			<string>Wilcom Embroidery Design</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>emb</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.britonleap.dst</string>
			<key>UTTypeDescription</key>
			<string>Tajima Embroidery Design</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>dst</string>
				</array>
			</dict>
		</dict>
	</array>

	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Wilcom Embroidery Design</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<!-- Alternate: Wilcom's own software is the editor for .emb, and StitchPeek only
			     reads the preview inside. Set to Owner, or use Get Info, to make it the default. -->
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.bobbymarko.stitchpeek.wilcom-emb</string>
				<string>com.britonleap.emb</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Tajima Embroidery Design</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.bobbymarko.stitchpeek.tajima-dst</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Tajima Embroidery Design</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<!-- Alternate, not Owner: Embrilliance is the editor on this machine and stealing
			     its default handler is not StitchPeek's call to make. To make StitchPeek the
			     default anyway, change this to Owner, or set it in Finder's Get Info panel. -->
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.britonleap.dst</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
